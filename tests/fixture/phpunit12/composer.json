{
    "name": "opcov/fixture-phpunit12",
    "description": "opcov/phpunit fixture project run under phpunit12",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
        "opcov/phpunit": "@dev",
        "phpunit/phpunit": "12.5.*",
        "brianium/paratest": "7.20.*"
    },
    "autoload": {
        "psr-4": {
            "Fixture\\": "../src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
